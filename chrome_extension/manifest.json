{
  "manifest_version": 3,
  "name": "Subrim — legendas no YouTube",
  "version": "0.3.0",
  "description": "Mostra legendas chinesas estilo subrim (pinyin, hanzi e tradução por palavra) sobre vídeos do YouTube.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:7997/*"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Subrim",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["inject_main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["render.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
