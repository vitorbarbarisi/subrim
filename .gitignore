# Ignore generated screenshots
r36s_viewer
*.png
# ...exceto o ícone do app (gerado por tools/make_icon.py, mas versionado)
!subrim_icon.png

# Bundles gerados por dictation/make_bundle.py (grandes, e derivados de uma coleção)
dictation/*_ditado_*.html
# Cache das decomposições da hanzi-api: derivado, e regenerável apagando o arquivo
dictation/.hanzi_cache.json

# Ignore warehouse media files
warehouse/*


# Ignore audio files
*.mp3

# Ignore assets folder (contains large/generated inputs)
assets/

# macOS Finder
.DS_Store

# Environment variables
.env
# Python cache files
__pycache__/
*.pyc
*.pyo

# Google OAuth credentials
client_secret_*.json
google_drive_config.json
warehouse/screenshots/

# Data files
*.csv
*.json

# Archive files
*.zip

# YouTube channel monitor: cookies são credencial, sem regra *.txt existente
cookies.txt
youtube_monitor.lock
logs/
!youtube_channels.example.json

# Log de depuração das chamadas à DeepSeek (grande, e regenerado a cada execução)
deepseek_debug.log
